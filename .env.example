# SkillBridge configuration. Copy to .env (gitignored). No API keys: Google auth uses Application Default Credentials
# (`gcloud auth application-default login` locally, the Cloud Run service account in production).

# Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
# Gemini chat models are served from `global` (widest model availability); embeddings stay regional
LLM_LOCATION=global
LLM_EMBED_LOCATION=us-central1

# Models: verify current IDs in Vertex AI Model Garden
# Reasoning: request parsing, team formation, executive briefs, Concierge function calling
LLM_CHAT_MODEL=gemini-3.5-flash
# Fast, high-volume: hidden-skill inference, document skill extraction, short explanations
LLM_FAST_MODEL=gemini-3.5-flash
# Thinking per role: a token budget (0 = off) or a level (MINIMAL, LOW, MEDIUM, HIGH)
LLM_CHAT_THINKING=LOW
LLM_FAST_THINKING=MINIMAL
LLM_EMBED_MODEL=gemini-embedding-001
LLM_EMBED_DIMS=768
LLM_TIMEOUT_S=30
# live | cache-first (scripted demo questions answer from the golden cache)
LLM_MODE=live

# Persistence and services (Cloud Run)
SNAPSHOT_BUCKET=
TOOLS_TOKEN=
